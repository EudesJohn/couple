{
  "expo": {
    "name": "Notre Bulle",
    "slug": "notre-bulle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/web-icon.png",
    "splash": {
      "image": "./assets/web-splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F0EB"
    },
    "userInterfaceStyle": "light",
    "scheme": "notre-bulle",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.couple.notrebulle",
      "infoPlist": {
        "UIBackgroundModes": [
          "voip",
          "audio"
        ],
        "NSPhotoLibraryUsageDescription": "Pour partager des photos dans notre bulle",
        "NSCameraUsageDescription": "Pour prendre des photos et vidéos",
        "NSMicrophoneUsageDescription": "Pour envoyer des notes vocales et appeler",
        "NSFaceIDUsageDescription": "Pour déverrouiller l'app avec ton visage"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF6F9",
        "foregroundImage": "./assets/web-adaptive-foreground.png",
        "backgroundImage": "./assets/web-adaptive-background.png",
        "monochromeImage": "./assets/web-adaptive-monochrome.png"
      },
      "package": "com.couple.notrebulle",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_FINGERPRINT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/web-favicon.png",
      "bundler": "metro",
      "output": "single",
      "meta": {
        "viewport": "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
      },
      "name": "Notre Bulle",
      "shortName": "Notre Bulle",
      "description": "L'espace privé pour nous deux",
      "lang": "fr-FR",
      "scope": "/",
      "themeColor": "#7C2D12",
      "backgroundColor": "#F5F0EB",
      "preferRelatedApplications": false,
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26,
            "newArchEnabled": false,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# react-native-webrtc\n-keep class com.oney.WebRTCModule.** { *; }\n-keep class org.webrtc.** { *; }\n# react-native-incall-manager\n-keep class com.zxcpoiu.incallmanager.** { *; }"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#7C2D12",
          "sounds": [
            "assets/sounds/bulle_douce.wav",
            "assets/sounds/coeur_bat.wav",
            "assets/sounds/carillon_or.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour partager des photos dans notre bulle",
          "cameraPermission": "Pour prendre des photos et vidéos"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pour déverrouiller l'app avec ton visage"
        }
      ],
      "./plugins/with-pip",
      "expo-document-picker",
      "expo-audio",
      "expo-video",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "supabaseUrl": "https://jaokoojmfplrknthrbhf.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imphb2tvb2ptZnBscmtudGhyYmhmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMyOTc2MDYsImV4cCI6MjA5ODg3MzYwNn0.O1_5ZOQabstKI8Vxu5bG8GWu-jXHQ9roBMhQ21tSOyM",
      "myProfileId": "3cd819d0-1ca8-4f0a-aa16-b8eb8e572b1c",
      "partnerProfileId": "0edca7b6-262c-4c0b-b638-a061c937536c",
      "appPin": "1234",
      "meteredApiKey": "b6285787a4b9ab52bf9cd8908432e84708a9",
      "eas": {
        "projectId": "18dffa45-9835-4f48-a312-1fee6fdf51c4"
      }
    },
    "owner": "eudesjohnson"
  }
}
