{
  "expo": {
    "name": "Notre Bulle",
    "slug": "notre-bulle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "notre-bulle",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.couple.notrebulle",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pour partager des photos dans notre bulle",
        "NSCameraUsageDescription": "Pour prendre des photos et vidéos",
        "NSMicrophoneUsageDescription": "Pour envoyer des notes vocales et appeler",
        "NSFaceIDUsageDescription": "Pour déverrouiller l'app avec ton visage"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF6F9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.couple.notrebulle",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-av",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#7C2D12"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour partager des photos dans notre bulle",
          "cameraPermission": "Pour prendre des photos et vidéos"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pour déverrouiller l'app avec ton visage"
        }
      ],
